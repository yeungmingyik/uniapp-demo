.page{min-height:100vh;background:#f6f7fb;display:flex;flex-direction:column;padding-bottom:130rpx}.content{flex:1;padding:32rpx 48rpx 40rpx}.user-header{display:flex;flex-direction:row;align-items:center;margin-bottom:24rpx}.avatar{width:96rpx;height:96rpx;border-radius:48rpx;background-color:#f0f0f0}.user-info{margin-left:40rpx;display:flex;flex-direction:column}.greeting-row{display:flex;align-items:center}.greeting{font-size:32rpx;color:#222;font-weight:600}.user-picker{display:flex;align-items:center;padding:8rpx 16rpx;background-color:#f5f5f5;border-radius:12rpx;margin-left:16rpx}.picker-text{font-size:26rpx;color:#333;margin-right:6rpx}.picker-icon{font-size:22rpx;color:#999}.sub-info{margin-top:12rpx;font-size:24rpx;color:#8f98a3}.date{margin-top:12rpx;font-size:32rpx;font-weight:700;color:#2e2e2e}.tab-panel{margin-top:32rpx}.section-title{margin-bottom:20rpx;font-size:40rpx;font-weight:700;color:#111}.cards{display:flex;flex-direction:column;gap:20rpx}.card{background-color:#fff;border-radius:20rpx;padding:24rpx;box-shadow:0 6rpx 20rpx rgba(0,0,0,.06);position:relative;height:200rpx}.card-header-row{display:flex;align-items:center;justify-content:space-between}.card-title{font-size:28rpx;color:#333;font-weight:600}.card-icon{height:52rpx;width:52rpx}.card-value{position:absolute;left:24rpx;bottom:32rpx;display:flex;align-items:baseline}.value-text{font-size:68rpx;font-weight:700;color:#111;line-height:1}.unit-text{margin-left:12rpx;font-size:26rpx;color:#9aa1a9;line-height:1}.card-time{position:absolute;right:24rpx;bottom:32rpx;font-size:24rpx;color:#9aa1a9}.device-list{display:flex;flex-direction:column;gap:20rpx}.device-item{padding:32rpx;border-radius:20rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(0,0,0,.05);display:flex;flex-direction:column;gap:20rpx;border:2rpx solid transparent}.device-item.active{border-color:#37c189;box-shadow:0 10rpx 24rpx rgba(55,193,137,.15)}.device-main{display:flex;flex-direction:column;gap:6rpx}.device-main-row{width:100%;display:flex;align-items:center;justify-content:space-between}.device-actions{display:flex;gap:20rpx}.device-action-btn{flex:1;padding:22rpx 0;text-align:center;border-radius:999rpx;font-size:28rpx;font-weight:600;color:#fff}.device-action-btn.success{background:linear-gradient(135deg,#40c78d,#1e8e5b);box-shadow:0 8rpx 20rpx rgba(30,142,91,.2)}.device-action-btn.success.disabled{background:#c0c7cf;box-shadow:none;color:#fff;pointer-events:none}.device-action-btn.danger{background:linear-gradient(135deg,#f36a6a,#dd4040);box-shadow:0 8rpx 20rpx rgba(221,64,64,.25)}.empty-device{padding:120rpx 0;display:flex;flex-direction:column;align-items:center;text-align:center}.health-empty{padding:80rpx 0}.empty-image{width:240rpx;height:240rpx;margin-bottom:32rpx}.empty-text{font-size:28rpx;color:#8f98a3;margin-bottom:32rpx}.placeholder-card{background:#fff;border-radius:20rpx;padding:48rpx 40rpx;box-shadow:0 6rpx 20rpx rgba(0,0,0,.06);display:flex;flex-direction:column;gap:16rpx}.placeholder-title{font-size:32rpx;font-weight:600;color:#222}.placeholder-sub{font-size:26rpx;color:#8f98a3}.primary-btn{min-width:320rpx;padding:24rpx 0;border-radius:999rpx;background:linear-gradient(135deg,#518dfc,#3c6ce6);color:#fff;font-size:28rpx;font-weight:600;text-align:center;box-shadow:0 12rpx 30rpx rgba(60,108,230,.25);margin-top:8rpx}.primary-btn.outline{background:linear-gradient(135deg,#518dfc,#3c6ce6);color:#fff;border:none;box-shadow:0 12rpx 30rpx rgba(60,108,230,.25)}.bottom-nav{position:fixed;left:0;right:0;bottom:0;height:120rpx;background:#fff;box-shadow:0 -10rpx 30rpx rgba(0,0,0,.08);display:flex;align-items:center;justify-content:space-around;padding-bottom:env(safe-area-inset-bottom)}.nav-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#a4a4a4}.nav-btn.active{color:#3c3c3c}.nav-icon{width:48rpx;height:48rpx;margin-bottom:6rpx}.nav-text{font-size:24rpx}.modal-mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:999}.modal-card{width:620rpx;background:#fff;border-radius:28rpx;padding:40rpx 36rpx;box-shadow:0 20rpx 40rpx rgba(0,0,0,.15)}.modal-title{font-size:32rpx;font-weight:600;text-align:center;color:#222}.modal-body{margin-top:32rpx;display:flex;flex-direction:column;gap:24rpx}.input-group{display:flex;flex-direction:column;gap:12rpx}.input-label{font-size:26rpx;color:#666}.input-field{height:88rpx;background:#f5f5f5;border-radius:16rpx;padding:0 24rpx;font-size:28rpx;color:#333}.modal-actions{margin-top:36rpx;display:flex;justify-content:flex-end;gap:24rpx}.action-btn{min-width:160rpx;text-align:center;padding:20rpx 0;border-radius:999rpx;font-size:28rpx;font-weight:600}.action-btn.ghost{background:#f1f2f5;color:#666}.action-btn.primary{background:linear-gradient(135deg,#40c78d,#1e8e5b);color:#fff;box-shadow:0 8rpx 24rpx rgba(30,142,91,.25)}
