
.page {
		padding: 32rpx;
		background-color: #F8F8F8;
		min-height: 100vh;
}
.header {
		margin-bottom: 32rpx;
}
.title {
		font-size: 36rpx;
		font-weight: 700;
		color: #111111;
		display: block;
		margin-bottom: 8rpx;
}
.subtitle {
		font-size: 26rpx;
		color: #666666;
		display: block;
}
.chart-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16rpx;
		margin-bottom: 24rpx;
}
.date-selector {
		display: flex;
		align-items: center;
		gap: 12rpx;
}
.date-button {
		display: flex;
		align-items: center;
		padding: 12rpx 24rpx;
		border: 1rpx solid #d0d0d0;
		border-radius: 999rpx;
		background-color: #fff;
		box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.05);
}
.calendar-icon {
		width: 28rpx;
		height: 28rpx;
		border: 2rpx solid #3c3c3c;
		border-radius: 4rpx;
		margin-right: 12rpx;
		position: relative;
}
.calendar-icon::before,
	.calendar-icon::after {
		content: '';
		position: absolute;
		left: 4rpx;
		right: 4rpx;
		height: 2rpx;
		background-color: #3c3c3c;
}
.calendar-icon::before {
		top: 6rpx;
}
.calendar-icon::after {
		top: 14rpx;
}
.date-button-text {
		font-size: 26rpx;
		color: #3c3c3c;
}
.clear-date {
		font-size: 24rpx;
		color: #ff4d4f;
		padding: 6rpx 12rpx;
}
.range-buttons {
		display: flex;
		align-items: center;
		gap: 12rpx;
		flex-wrap: wrap;
}
.range-button {
		padding: 12rpx 24rpx;
		border-radius: 999rpx;
		border: 1rpx solid #d0d0d0;
		font-size: 24rpx;
		color: #555;
		background-color: #fff;
		box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.05);
}
.range-button.active {
		background-color: #3c3c3c;
		color: #fff;
		border-color: #3c3c3c;
}
.chart-container {
		background-color: #FFFFFF;
		border-radius: 16rpx;
		padding: 20rpx 10rpx 30rpx 0;
		margin: 0 0 32rpx -10rpx;
		box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.06);
		height: 520rpx;
		width: calc(100% + 10rpx);
		overflow: hidden;
		box-sizing: border-box;
}
.chart-canvas {
		width: 100% !important;
		height: 100% !important;
}
.data-stats {
		background-color: #FFFFFF;
		border-radius: 16rpx;
		padding: 32rpx;
		display: flex;
		flex-direction: column;
		gap: 24rpx;
		box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.06);
}
.stat-item {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 16rpx 20rpx;
		border-radius: 12rpx;
		background: linear-gradient(120deg, #f9fafc, #f1f3f6);
		box-shadow: inset 0 0 0 1rpx rgba(0,0,0,0.02);
}
.stat-label {
		font-size: 24rpx;
		color: #999999;
		margin-bottom: 8rpx;
}
.stat-value {
		font-size: 32rpx;
		font-weight: 700;
		color: #111111;
}
.empty-state {
		text-align: center;
		padding: 100rpx 0;
		color: #999999;
		font-size: 28rpx;
}
