<view class="page"><view class="user-header"><image class="avatar" src="{{a}}" mode="aspectFill"></image><view class="user-texts"><view class="greeting-row"><text class="greeting">你好，{{b}}👋</text><picker wx:if="{{c}}" bindchange="{{e}}" value="{{f}}" range="{{g}}" range-key="label"><view class="user-picker"><text class="picker-text">{{d}}</text><text class="picker-icon">▼</text></view></picker></view><text class="date">{{h}}</text></view></view><view class="section-title">我的设备</view><view class="device-filter"><view class="filter-row"><view class="filter-item"><text class="filter-label">设备ID</text><picker wx:if="{{i}}" bindchange="{{k}}" value="{{l}}" range="{{m}}" range-key="label"><view class="filter-picker"><text class="picker-text">{{j}}</text><text class="picker-icon">▼</text></view></picker></view><view class="filter-item"><text class="filter-label">设备名称</text><picker wx:if="{{n}}" bindchange="{{p}}" value="{{q}}" range="{{r}}" range-key="label"><view class="filter-picker"><text class="picker-text">{{o}}</text><text class="picker-icon">▼</text></view></picker></view></view></view><view class="section-title">健康数据</view><view class="cards"><view class="card" bindtap="{{x}}"><view class="card-header-row"><text class="card-title">体温</text><image class="card-icon" src="{{s}}" mode="heightFix"></image></view><view class="card-value"><text class="value-text">{{t}}</text><text wx:if="{{v}}" class="unit-text">℃</text></view><view class="card-time">{{w}}</view></view><view class="card" bindtap="{{C}}"><view class="card-header-row"><text class="card-title">心率</text><image class="card-icon" src="{{y}}" mode="heightFix"></image></view><view class="card-value"><text class="value-text">{{z}}</text><text wx:if="{{A}}" class="unit-text">bpm</text></view><view class="card-time">{{B}}</view></view><view class="card" bindtap="{{H}}"><view class="card-header-row"><text class="card-title">血氧饱和度</text><image class="card-icon" src="{{D}}" mode="heightFix"></image></view><view class="card-value"><text class="value-text">{{E}}</text><text wx:if="{{F}}" class="unit-text">%</text></view><view class="card-time">{{G}}</view></view></view></view>